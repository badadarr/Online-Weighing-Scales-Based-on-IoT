{
  "rules": {
    "authorized_users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isBoolean()"
      }
    },
    "rfid_users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['uid']) && newData.child('uid').isString() && newData.child('uid').val() == $uid && (newData.child('active').exists() ? newData.child('active').isBoolean() : true)"
      }
    },
    "rfid_requests": {
      ".read": "auth != null",
      ".write": true,
      "$uid": {
        ".read": "auth != null",
        ".write": true,
        ".validate": "newData.hasChildren(['device_id','request_time']) && (newData.child('approved').exists() ? newData.child('approved').isBoolean() : true) && (newData.child('status').exists() ? newData.child('status').isString() : true)"
      }
    },
    "device_users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$device_id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        "authorized": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "devices": {
      "$device": {
        "berat_terakhir": {
          ".read": true,
          ".write": true
        },
        "log": {
          ".read": true,
          ".write": true
        },
        "current": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['weight', 'timestamp', 'device_id'])"
        },
        "history": {
          "$timestamp": {
            ".read": true,
            ".write": true,
            ".validate": "newData.hasChildren(['weight', 'timestamp', 'device_id'])"
          }
        }
      }
    }
  }
}
